ONAIR_MQTT_HOST=192.168.88.40
ONAIR_MQTT_PORT=1883
ONAIR_MQTT_TOPIC=meshcore/#
# Für MQTT über TCP/TLS aktivieren und ONAIR_MQTT_PORT auf den TLS-Port setzen (meist 8883).
ONAIR_MQTT_TLS=false
ONAIR_MQTT_USERNAME=
ONAIR_MQTT_PASSWORD=
# Optional: PEM-CA-Datei; im Docker-Container z. B. /data/mqtt-ca.crt.
ONAIR_MQTT_CA_CERTS=
ONAIR_HTTP_PORT=8083
# TX-Meldungen in Terminal/Docker-Logs anzeigen (nicht in Webansicht/Archiv).
ONAIR_SHOW_TX=false
# Historische DX-/TRACE-Positionen: legacy, compare oder normalized.
ONAIR_POSITION_MODE=legacy
